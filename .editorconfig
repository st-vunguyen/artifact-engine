# EditorConfig — https://editorconfig.org
# Universal style for the artifact-engine repo.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Trailing whitespace can be meaningful in Markdown (line break) — keep it.
trim_trailing_whitespace = false
max_line_length = off

[*.{json,jsonc,yaml,yml,ts,tsx,js,jsx,mjs,cjs}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
