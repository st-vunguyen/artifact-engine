{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "artifact-engine.core/artifact-contracts/metadata/execution-state-schema.json",
  "title": "Execution State Schema",
  "description": "Shape of runtime/active-executions/<run-id>/run.state.json",
  "type": "object",
  "required": [
    "run_id",
    "workflow_id",
    "state",
    "phases",
    "started_at",
    "last_transition_at"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "workflow_id": { "type": "string" },
    "state": {
      "type": "string",
      "enum": [
        "CREATED",
        "PLANNING",
        "RUNNING",
        "BLOCKED",
        "RECOVERING",
        "PUBLISHING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "phases": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["pending", "running", "succeeded", "failed", "skipped"]
      }
    },
    "retries": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["blocker_id", "reason", "raised_by"],
        "properties": {
          "blocker_id": { "type": "string" },
          "reason": { "type": "string" },
          "raised_by": { "type": "string" },
          "affected_artifacts": {
            "type": "array",
            "items": { "type": "string" }
          },
          "remediation": { "type": "string" }
        }
      }
    },
    "produced": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "checksum"],
        "properties": {
          "path": { "type": "string" },
          "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 0 },
          "artifact_kind": { "type": "string" },
          "contract": { "type": "string" }
        }
      }
    },
    "evidence_coverage_so_far": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "started_at": { "type": "string", "format": "date-time" },
    "last_transition_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
