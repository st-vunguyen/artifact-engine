{
  "version": "1.0",
  "description": "Stub of the semantic icon manifest. Tokens are 'domain.object.state'. Real manifest extends this with SVG paths.",
  "tokens": {
    "commerce.cart.empty":         { "icon": "fa-cart", "label": "Empty cart" },
    "commerce.cart.populated":     { "icon": "fa-cart-arrow-down", "label": "Populated cart" },
    "commerce.order.pending":      { "icon": "fa-hourglass", "label": "Order pending" },
    "commerce.order.confirmed":    { "icon": "fa-check-circle", "label": "Order confirmed" },
    "commerce.order.cancelled":    { "icon": "fa-times-circle", "label": "Order cancelled" },
    "commerce.order.shipped":      { "icon": "fa-truck", "label": "Shipped" },

    "payment.charge.pending":      { "icon": "fa-spinner", "label": "Charge pending" },
