    "fulfillment.shipment.pending":    { "icon": "fa-box", "label": "Shipment pending" },
    "fulfillment.shipment.in-transit": { "icon": "fa-shipping-fast", "label": "In transit" },
    "fulfillment.shipment.delivered":  { "icon": "fa-box-open", "label": "Delivered" }
