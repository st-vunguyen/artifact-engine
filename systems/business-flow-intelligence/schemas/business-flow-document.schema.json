{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "artifact-engine.systems/business-flow/schemas/business-flow-document.schema.json",
  "title": "Business Flow Document (17-section)",
  "type": "object",
  "required": [
    "scope", "source_inventory", "summary", "flow_table", "narrative",
    "decisions", "traceability", "open_questions", "assumptions",
    "gap_taxonomy", "state_machine", "permissions", "async_events",
    "risk_hotspots", "scenario_seeds", "contradictions", "validation_report"
  ],
  "properties": {
    "scope": { "type": "object" },
    "source_inventory": { "type": "array" },
    "summary": { "type": "string", "minLength": 150 },
    "flow_table": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/FlowRow" }
    },
    "narrative": { "type": "string", "minLength": 400 },
    "decisions": { "type": "array", "items": { "$ref": "#/definitions/Decision" } },
    "traceability": { "type": "array" },
    "open_questions": { "type": "array" },
    "assumptions": { "type": "array" },
    "gap_taxonomy": { "type": "array", "items": { "$ref": "#/definitions/Gap" } },
    "state_machine": { "$ref": "#/definitions/StateMachine" },
    "permissions": { "type": "array", "items": { "$ref": "#/definitions/Permission" } },
    "async_events": { "type": "array" },
    "risk_hotspots": { "type": "array" },
    "scenario_seeds": { "type": "array" },
    "contradictions": { "type": "array" },
    "validation_report": { "$ref": "#/definitions/ValidationReport" }
  },
  "definitions": {
    "FlowRow": {
      "type": "object",
      "required": ["step_id", "actor", "action", "system", "outcome", "evidence"],
      "properties": {
        "step_id": { "type": "string", "pattern": "^S\\d{2,3}$" },
        "actor": { "type": "string" },
        "action": { "type": "string" },
        "decision_ref": { "type": "string" },
        "system": { "type": "string" },
        "outcome": { "type": "string" },
        "evidence": { "type": "array", "minItems": 1 }
      }
    },
    "Decision": {
      "type": "object",
      "required": ["decision_id", "condition", "branches"],
      "properties": {
        "decision_id": { "type": "string", "pattern": "^D\\d{2,3}$" },
        "condition": { "type": "string" },
        "branches": { "type": "array", "minItems": 2 }
      }
    },
    "Gap": {
      "type": "object",
      "required": ["gap_id", "category", "topic", "why_unknown", "what_to_ask", "severity"],
      "properties": {
        "gap_id": { "type": "string", "pattern": "^G\\d{2,3}$" },
        "category": { "type": "string", "enum": ["input-validation", "error-handling", "permission", "async-failure", "data-integrity", "ui-state", "performance", "security", "other"] },
        "severity": { "type": "string", "enum": ["info", "minor", "major", "critical"] }
      }
    },
    "StateMachine": {
      "type": "object",
      "required": ["states", "transitions", "initial"],
      "properties": {
        "states": { "type": "array" },
        "transitions": { "type": "array" },
        "initial": { "type": "string" },
        "terminal": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Permission": {
      "type": "object",
      "required": ["permission_id", "actor_id", "action", "resource", "allowed", "evidence"],
      "properties": {
        "permission_id": { "type": "string", "pattern": "^P\\d{2,3}$" }
      }
    },
    "ValidationReport": {
      "type": "object",
      "required": ["sections_present", "evidence_coverage", "gaps", "contradictions"],
      "properties": {
        "sections_present": { "type": "integer", "const": 17 },
        "evidence_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "gaps": { "type": "integer", "minimum": 0 },
        "contradictions": { "type": "integer", "minimum": 0 },
        "risk_to_seed_coverage": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
