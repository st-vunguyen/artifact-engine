{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "artifact-engine.systems/api-testing/schemas/postman-collection.schema.json",
  "title": "Postman Collection (per-status enforced)",
  "description": "Postman v2.1 collection schema with per-status request mandate.",
  "type": "object",
  "required": ["info", "item"],
  "properties": {
    "info": {
      "type": "object",
      "required": ["name", "schema"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "schema": { "type": "string", "const": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" }
      }
    },
    "item": {
      "type": "array",
      "description": "Folders or requests; folders may contain nested items per OAS tag",
      "items": { "$ref": "#/definitions/Item" }
    },
    "auth": { "$ref": "#/definitions/Auth" },
    "event": { "type": "array", "items": { "$ref": "#/definitions/Event" } },
    "variable": { "type": "array", "items": { "$ref": "#/definitions/Variable" } }
  },
  "definitions": {
    "Item": {
      "oneOf": [
        { "$ref": "#/definitions/Folder" },
        { "$ref": "#/definitions/Request" }
      ]
    },
    "Folder": {
      "type": "object",
      "required": ["name", "item"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "item": { "type": "array", "items": { "$ref": "#/definitions/Item" } }
      }
    },
    "Request": {
      "type": "object",
      "required": ["name", "request", "response", "event"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^.+ — \\d{3} .+$",
          "description": "Naming: '{Verb Noun} — {CODE} {Label}'"
        },
        "request": {
          "type": "object",
          "required": ["method", "url"],
          "properties": {
            "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] },
            "url": { "$ref": "#/definitions/Url" },
            "header": { "type": "array" },
            "body": { "type": "object" }
          }
        },
        "response": {
          "type": "array",
          "minItems": 1,
          "description": "MUST be populated; per-status rule"
        },
        "event": {
          "type": "array",
          "minItems": 1,
          "description": "MUST contain at least one pm.test assertion block",
          "items": { "$ref": "#/definitions/Event" }
        }
      }
    },
    "Url": {
      "type": "object",
      "properties": {
        "raw": { "type": "string" },
        "host": { "type": "array", "items": { "type": "string" } },
        "path": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Auth": { "type": "object" },
    "Event": {
      "type": "object",
      "properties": {
        "listen": { "type": "string", "enum": ["test", "prerequest"] },
        "script": { "type": "object" }
      }
    },
    "Variable": { "type": "object" }
  }
}
