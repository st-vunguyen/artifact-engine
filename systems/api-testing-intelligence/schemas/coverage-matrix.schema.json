{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "artifact-engine.systems/api-testing/schemas/coverage-matrix.schema.json",
  "title": "API Coverage Matrix",
  "type": "object",
  "required": ["operations_total", "rows"],
  "properties": {
    "operations_total": { "type": "integer", "minimum": 0 },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["operationId", "status", "documented", "has_scenario", "state"],
        "properties": {
          "operationId": { "type": "string" },
          "status": { "type": "integer", "minimum": 100, "maximum": 599 },
          "documented": { "type": "boolean" },
          "has_scenario": { "type": "boolean" },
          "scenario_id": { "type": "string" },
          "has_data_sample": { "type": "boolean" },
          "has_test_assertion": { "type": "boolean" },
          "status_kind": {
            "type": "string",
            "enum": ["happy", "validation", "auth", "permission", "conflict", "rate-limit", "server"]
          },
          "state": {
            "type": "string",
            "enum": ["Covered", "Planned", "Blocked", "Out of scope with reason", "Unknown / needs confirmation"]
          },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
